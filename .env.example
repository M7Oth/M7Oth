# ---- server ----
# PostgreSQL connection string. If unset, the server falls back to a local JSON file (development only).
DATABASE_URL=postgres://fls:fls@localhost:5432/fls
PORT=8787
# Allow the restricted CORS origin when the client is hosted on another domain (e.g. https://your-site.netlify.app)
CORS_ORIGIN=*
# Enables the `devGrant` cheat action — ONLY for local testing / the e2e scenario. Never enable in production.
ALLOW_DEV_CHEATS=0

# ---- client (build time) ----
# Public URL of the game server when the client is hosted separately (Vercel/Netlify). Leave empty for same-origin.
VITE_SERVER_URL=
