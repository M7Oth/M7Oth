{
  "name": "freelancer-life-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client",
    "e2e": "node e2e/full-scenario.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0"
  }
}
